{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "醫檢師培養基成分大綱 資料結構",
  "type": "object",
  "required": ["meta", "media"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["subject", "media_types"],
      "properties": {
        "subject": { "type": "string" },
        "version": { "type": "string" },
        "updated": { "type": "string" },
        "source": { "type": "string" },
        "media_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "flows": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["h1","type","abbr","en","zh","stars","comp","ph","steril","principle","appear","species","hot","qa"],
        "additionalProperties": false,
        "properties": {
          "h1": { "type": "string" },
          "type": { "type": "string" },
          "abbr": { "type": "string" },
          "en": { "type": "string" },
          "zh": { "type": "string" },
          "stars": { "type": "integer", "minimum": 1, "maximum": 3 },
          "comp": {
            "type": "array", "minItems": 1,
            "items": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
          },
          "ph": { "type": "string" },
          "steril": { "type": "string" },
          "principle": { "type": "string" },
          "appear": { "type": "string" },
          "species": {
            "type": "array", "minItems": 1,
            "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
          },
          "hot": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "qa": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "description": "跨培養基比較矩陣（如腸道盤判讀對照）；scope 對應某 h1。",
      "items": {
        "type": "object",
        "required": ["scope", "columns", "rows"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "scope": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string" },
          "footnote": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
        }
      }
    }
  }
}
